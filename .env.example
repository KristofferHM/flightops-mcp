# --- OpenSky Network (optional; the server works without these) --------------
# Create a free account at https://opensky-network.org, then Account -> API Client.
# The client id ends in "-api-client" and is only valid for the REST API.
FLIGHTOPS_OPENSKY_CLIENT_ID=
FLIGHTOPS_OPENSKY_CLIENT_SECRET=

# --- Reference data ----------------------------------------------------------
# Build it first: uv run python scripts/build_airports_db.py --csv data/airports_seed.csv
FLIGHTOPS_AIRPORTS_DB=data/airports.sqlite3

# --- Behaviour ---------------------------------------------------------------
FLIGHTOPS_LOG_LEVEL=INFO
FLIGHTOPS_CREDIT_BUDGET_PER_HOUR=400
FLIGHTOPS_MAX_RATE_LIMIT_WAIT_S=5
