{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tool calls per second, by tool",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (tool) (rate(flightops_tool_calls_total[5m]))",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tool outcomes that are not ok",
      "description": "ok=false payloads are normal for the model and news for the operator: not_found, upstream_rate_limited, local_budget_exhausted and friends.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(flightops_tool_calls_total{outcome!=\"ok\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Upstream latency p50 / p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, upstream) (rate(flightops_upstream_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{upstream}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, upstream) (rate(flightops_upstream_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{upstream}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Circuit open (1 = refusing traffic)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "max by (upstream) (flightops_circuit_open)", "legendFormat": "{{upstream}}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "OpenSky credits spent in the last hour",
      "description": "A standard OpenSky account gets 4,000 credits per day per endpoint family.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "increase(flightops_opensky_credits_spent_total[1h])", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Upstream requests by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (upstream, status) (rate(flightops_upstream_requests_total[5m]))",
          "legendFormat": "{{upstream}} {{status}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["flightops", "mcp"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timezone": "browser",
  "title": "flightops-mcp",
  "uid": "flightops-mcp",
  "version": 1
}
