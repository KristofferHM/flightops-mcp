# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local secrets and data
.env
.env.*
!.env.example

# Downloaded / generated reference data (rebuild with scripts/build_airports_db.py)
data/airports.csv
data/*.sqlite3
data/*.sqlite3-journal

# Test and tooling artefacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
probe_*.py

# Agent run transcripts (uv run python -m agent run ...)
agent-runs/

# Evaluation run output (uv run python -m evals.run --out ...). The baseline is
# evals/baseline.json and is committed; a run's results are not.
eval-runs/

# Local Claude Code overrides (the committed .claude/settings.json is the shared one)
.claude/settings.local.json
.hypothesis/
